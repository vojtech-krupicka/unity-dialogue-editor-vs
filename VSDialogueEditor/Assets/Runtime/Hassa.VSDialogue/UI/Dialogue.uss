.container {
    flex-grow: 1;
    width: auto;
    height: auto;
    max-height: none;
    max-width: none;
    align-items: center;
}

.dialogue-container {
    background-color: rgba(0, 0, 0, 0.75);
    position: absolute;
    bottom: 10px;
    min-height: 64px;
    width: 900px;
    border-radius: 8px;
    padding: 12px;
    flex-direction: column;
    align-items: flex-start;
}
.dialogue-container Label {
    color: white;
    text-shadow: 4px 4px 4px rgba(0, 0, 0, 1);
}

.header {
    width: 100%;
    flex-wrap: nowrap;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
}
.actor-icon {
    background-color: rgba(1, 1, 1, 0.75);
    width: 48px;
    height: 48px;
    margin-right: 8px;
}
.actor-name {
    flex-grow: 1;
    font-size: 16px;
}

.dialogue-text-box {
    flex-grow: 1;
    width: 100%;
    
}
.dialogue-text-box Label {
    flex-wrap: wrap;
    white-space: normal;
}

.dialogue-continue-button {
    flex-grow: 1;
    width: 100%;
    margin: 4px auto 0 auto;
    padding-top: 4px;
    padding-bottom: 4px;
    color: rgba(0, 0, 0, 0.95);
    -unity-font-style: bold;
    text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.75);
    border-radius: 4px;
}
.dialogue-continue-button:hover {
    background-color: #AF5700;
}

.dialogue-option-box {
    margin-left: 8px;
    flex-grow: 1;
    width: 100%;
}
.dialogue-option-box Label {
    padding-left: 8px;
    flex-wrap: wrap;
    white-space: normal;
}
.dialogue-option-box Label:hover {
    background-color: #AF5700;
}