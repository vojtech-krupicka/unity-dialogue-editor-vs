# This repo keeps the Unity project in the VSDialogueEditor/ subfolder, so the
# standard Unity ignore rules below are anchored to /VSDialogueEditor/ instead
# of the repo root.
#
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# See also: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/VSDialogueEditor/[Ll]ibrary/
/VSDialogueEditor/[Tt]emp/
/VSDialogueEditor/[Oo]bj/
/VSDialogueEditor/[Bb]uild/
/VSDialogueEditor/[Bb]uilds/
/VSDialogueEditor/[Ll]ogs/
/VSDialogueEditor/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/VSDialogueEditor/[Mm]emoryCaptures/

# Recordings can get excessive in size
/VSDialogueEditor/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /VSDialogueEditor/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/VSDialogueEditor/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/VSDialogueEditor/ServerData
/VSDialogueEditor/[Aa]ssets/StreamingAssets/aa*
/VSDialogueEditor/[Aa]ssets/AddressableAssetsData/link.xml*
/VSDialogueEditor/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /VSDialogueEditor/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/VSDialogueEditor/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/VSDialogueEditor/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/VSDialogueEditor/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/VSDialogueEditor/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/VSDialogueEditor/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/VSDialogueEditor/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/VSDialogueEditor/[Aa]ssets/[Ss]ceneDependencyCache*

# OS / editor cruft
.DS_Store
Thumbs.db
